<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SignBridgeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SignBridgeCommunication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LoginActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".ui.emergency.EmergencyActivity"
            android:exported="false"
            android:label="Emergency"
            android:theme="@style/Theme.SignBridgeCommunication">
        </activity>
        <activity
            android:name=".ui.comm.CommunicationModeActivity"
            android:exported="false"
            android:label="Communication Mode"
            android:theme="@style/Theme.SignBridgeCommunication">
        </activity>
        <activity
            android:name=".ui.detail.SignDetailActivity"
            android:exported="false"
            android:label="Sign Details"
            android:theme="@style/Theme.SignBridgeCommunication">
        </activity>
        <activity
            android:name=".ui.editprofile.EditProfileActivity"
            android:exported="false"
            android:label="Edit Profile"
            android:theme="@style/Theme.SignBridgeCommunication">
        </activity>
        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false"
            android:label="About SignBridge"
            android:theme="@style/Theme.SignBridgeCommunication">
        </activity>
    </application>

</manifest>