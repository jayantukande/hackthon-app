<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1C1E"
    android:padding="24dp">

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_revert"
        android:padding="12dp"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tv_large_phrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PHRASE TEXT"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/iv_sign_demo"
        app:layout_constraintVertical_chainStyle="packed"/>

    <ImageView
        android:id="@+id/iv_sign_demo"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:src="@android:drawable/ic_menu_gallery"
        android:layout_marginTop="32dp"
        android:background="#2D2F31"
        app:layout_constraintTop_toBottomOf="@id/tv_large_phrase"
        app:layout_constraintBottom_toTopOf="@id/btn_speak"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_speak"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="SPEAK"
        android:textSize="24sp"
        app:cornerRadius="40dp"
        android:layout_marginBottom="32dp"
        app:icon="@android:drawable/ic_btn_speak_now"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>